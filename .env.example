# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# MongoDB (Atlas). Use database name in the path, e.g. ...mongodb.net/plantmart?...
MONGODB_URI="mongodb+srv://USER:PASSWORD@CLUSTER/plantmart?appName=plantmart"
# Optional override if the URI path does not include the database name
# MONGODB_DB="plantmart"

# Signing key for session JWT (min 32 characters). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="replace-with-a-long-random-secret-at-least-32-chars"

# One-time first admin creation (POST /api/auth/bootstrap-admin). Remove or leave unset after use.
# BOOTSTRAP_ADMIN_SECRET="replace-with-random-secret"

# Seeded admin (written to MongoDB on server start via instrumentation). Use POST /api/admin/auth/login to sign in.
# Do not use the same email as a buyer/seller account. If the email exists as non-admin, seed is skipped.
# ADMIN_SEED_NAME="PlantMart Admin"
# ADMIN_SEED_EMAIL="admin@example.com"
# ADMIN_SEED_PASSWORD="change-me-strong-password"
